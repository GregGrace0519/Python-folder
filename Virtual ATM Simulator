print("Welcome to the ATM!")
user_name = input("Please enter your name: ")
user_balance = float(input("Enter your balance: $"))
balance = user_balance
running = True

def Display_Main_Menu():
    print("\nATM Main Menu:")
    print("1. Deposit")
    print("2. Withdraw")
    print("3. Check Balance")
    print("4. Exit")
    user_choice_2 = int(input("Please choose an option (1-4): "))
    return user_choice_2

def Deposit(balance):
    amount = float(input("Enter the amount to deposit: $"))
    balance = balance + amount
    print()
    print(f"Deposited ${amount}. New balance: ${balance}")
    return balance

def Withdraw(balance):
    amount = float(input("Enter the amount to withdraw: $"))
    if amount > balance:
        print("Insufficient funds.")
        print()
        return balance
    else:
        balance = balance - amount #This is the math that withdraws money.
        print(f"Withdrew ${amount}. New balance: ${balance}")
        print()
        return balance

def CheckBalance(balance):
    print(f"Your current balance is: ${balance}")
    print()

while running:
    user_choice_2 = Display_Main_Menu()

    match user_choice_2:
        case 1:
            balance = Deposit(balance)

        case 2:
            balance = Withdraw(balance)
        case 3:
            CheckBalance(balance)
        case 4:
            print(f"Goodbye, {user_name}! Thank you for using the ATM.")
            running = False

        case _:
            print("Invalid choice. Pleas try again.")
            print()
