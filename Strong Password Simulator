running = True
password_count = 0
All_passwords = []
Strong=[]
Moderate=[]
Weak=[]
#-----------------------------------
def has_upper(password):
    for char in password: #We have to create a FOR loop to loop through the password to look at each character
        if char.isupper():
            return True
    else:
        return False
#----------------------------------
def has_lower(password):
    for char in password:
        if char.islower():
            return True
    else:
        return False
#----------------------------------
def has_digits(password):
    for char in password: #This is going to loop through every character in the password.
        if char.isdigit(): #This is checking to see if that character is a digit or not.
            return True
    else:
        return False
#-----------------------------------
def classify_password(upper_check, lower_check, digits_check, password): #pass all of the previous methods in so you can use it in this method to classify the strength of the password
    if upper_check and lower_check and digits_check and len(password) >= 8:
        Strong.append(password) #The checks are "True/False" Boolean values
        strength = "Strong"
    elif len(password) >= 6 and (upper_check or lower_check) and digits_check: #Use the variable with the True/False Boolean Values. Use the stored result, not the variable name
        Moderate.append(password)
        strength = "Moderate"
    else:
        Weak.append(password)
        strength = "Weak"

    return strength
#--------------------------------------
def stop():
   global running #THis makes sure that "password" can be seen outside the method
   if password == "STOP":
        print("--- Password Report ---")

        print(f"Total passwords: {password_count}")

        print(f"Strong: {len(Strong)}") #This is going to loop through the list of "Strong" and tell me how many passwords are in there.


        print(f"Moderate: {len(Moderate)}")

        print(f"Weak: {len(Weak)}")

        longest = max(All_passwords,key=len)  # This means looks through all passwords and pick the one with the mox characters. Max is going to return the largest item in the list

        shortest = min(All_passwords, key=len)
        print(f"Longest password: {longest}")
        print(f"Shortest password: {shortest}")

        running = False
#--------------------------------------
while running:
    password = input("Enter password: ")
    if password == "STOP":
        stop()
    else:
        All_passwords.append(password) #We have to make a list called all passwords so we can find out what password is the longest and shortest

        password_count += 1 #Everytime you enter a password, the password counter goes up by 1.

        upper_check = has_upper(password) #Remmember to STORE your result. When a function return something. Usually save it as a variable. Python sees them as function besides True or false boolean variables.
        lower_check = has_lower(password) #Save your result into a variable
        digits_check = has_digits(password)
        password_check = classify_password(upper_check,lower_check,digits_check,password) #THis is me checking the password and saving it as a variable
        #Print Statements---------------------------------------------------

        print(f"Password Strength: {password_check}")
        print()
