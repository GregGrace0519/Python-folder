current_string = 6
print("Let's tune your guitar!")
while current_string >= 1 :

    if current_string == 6:
        string_name = "sixth"
        target_frequency = 82.41
    elif current_string == 5:
        string_name = "fifth"
        target_frequency = 110.00
    elif current_string == 4:
        string_name = "fourth"
        target_frequency = 146.83
    elif current_string == 3:
        string_name = "third"
        target_frequency = 196.00
    elif current_string == 2:
        string_name = "second"
        target_frequency = 246.94
    elif current_string == 1:
        string_name = "first"
        target_frequency = 329.63

    Frequency = float(input(f"\nWhat is the frequency of the {string_name} string?: "))

    if Frequency > target_frequency:
        print("Too High! Loosen the string.")

    elif Frequency < target_frequency:
        print("Too Low! Tighten the string.")

    elif Frequency == target_frequency:
        print("Perfect! You are in tune, let's move on to the next string...")
        current_string -= 1

else:
    print("\nYour guitar is tuned and ready to use!")





