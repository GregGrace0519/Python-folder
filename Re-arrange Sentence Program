user_sentence = input("Enter a sentence: ")

#We have to use this to split the sentence into words so we can sort the words
words = user_sentence.split()

short_words = []
medium_words = []
long_words = []

for word in words: #THis looks at each word
    if len(word) <= 3:
        short_words.append(word) # Append store words

    elif len(word) <=6:
        medium_words.append(word) #Store medium words into it's own list

    else:
        long_words.append(word)

final_list = short_words + medium_words + long_words

print("Rearranged sentence:"," ".join(final_list)) #Join equal rebuild sentence
