matrixB = [] #Store Matrix B as a list of rows
result = []

index = 0 #Keeps track of postioin inside the numbers of list
if columns == rows_1: #Checks if multiplicaiton is possible
    values = input("\nEnter Matrix A values (comma separated): ")
    numbers = values.split(",")  # Turns "1,2,3,4,5,6" into ['1','2','3','4','5','6']

    values_1 = input("\nEnter Matrix B values (comma separated): ")
    numbers_1 = values_1.split(",") #Split into rows, Matrix B numbers



    for r in range(rows): #Outer loop → makes each row
        row = [] #Create a NEW empty row
        for c in range(columns): #Inner loop. Fills the row with numbers
            row.append(int(numbers[index])) #Take number from list and add it into row
            index += 1 #Moves to next number
        matrixA.append(row) #After row is filled. Add it to matrixA

    print("\nMatrix A:")
    for r in matrixA:
        for value in r:
            print(value, end=" ")
        print()

    index = 0 #Put before the matrix loop, so it does not reset
    for r in range (rows_1):
        row=[]
        for c in range(columns_1):
            row.append(int(numbers_1[index]))
            index += 1
        matrixB.append(row)

