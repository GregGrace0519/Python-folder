            print(value, end=" ")
        print()

    for r in range (rows):

        row = []

        for c in range(columns_1):

            total = 0

            for k in range(columns):
                total += matrixA[r][k] * matrixB[k][c]

            row.append(total)

        result.append(row)

    print("\nResult Matrix:")

    for r in result:
