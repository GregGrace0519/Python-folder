def check_length(password):
    if len(password) < 8:
        return False
    else:
        return True
def check_password(password): #Checking Password Upper and Lower
    found_upper = False
    found_lower = False
    for char in password:
        if char.isupper():
            found_upper = True
        elif char.islower():
            found_lower = True
    return found_upper and found_lower

def check_special_Char(password):
    for char in password:
        if char == "!" or char == "@" or char == "#": #If a special character equals one of this characters. That means it is true
            return True
    else:
        return False

running = True



while running:

    user_input = input("Enter a password: ")


    length_ok = check_length(user_input)
    upper_ok = check_password(user_input)
    special_char_ok = check_special_Char(user_input)



    if length_ok and upper_ok and special_char_ok:
        print("Password is Strong")
        break

    if not (length_ok and upper_ok and special_char_ok):
        print("Password does not meet the requirements: ", end="")

    if not length_ok:
        print("Must be at least 8 characters long.", )

    if not upper_ok:
        print("Must contain both upper and lowercase letters.")

    if not special_char_ok:
        print("Must contain special characters (!,@,#).")
